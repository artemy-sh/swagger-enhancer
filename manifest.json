{
  "manifest_version": 3,
  "name": "Swagger Enhancer",
  "version": "1.0.1",
  "description": "Enhances the Swagger UI experience with visual and usability improvements.",
  "author": "Artemy Shalygin",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*docs*"
      ],
      "js": [
        "js/utils.js",
        "js/feature_manager.js",
        "js/floating_menu.js",
        "js/theme.js",
        "js/search.js",
        "js/favorites.js",
        "js/scroll_top.js",
        "js/hide_responses.js",
        "js/hide_schemas.js",
        "js/github_link.js",
        "js/main.js",
        "js/test_runner.js"
      ],
      "css": [
        "css/variables.css",
        "css/floating_menu.css",
        "css/search.css",
        "css/favorites.css",
        "css/scroll_top.css",
        "css/github_link.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "css/*.css",
        "js/page_test_functions.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}

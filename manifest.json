{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "Swagger Enhancer",
  "version": "2.1.0",
  "description": "Dark theme, full-spec search, favorites and inline schema previews for Swagger UI.",
  "author": "Artemy Shalygin",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*docs*",
        "*://*/*swagger*",
        "*://*/*openapi*"
      ],
      "js": [
        "js/utils.js",
        "js/site_rules.js",
        "js/favorites_store.js",
        "js/feature_manager.js",
        "js/floating_menu.js",
        "js/theme.js",
        "js/search.js",
        "js/favorites.js",
        "js/scroll_top.js",
        "js/hide_responses.js",
        "js/hide_schemas.js",
        "js/schema_preview.js",
        "js/authorize.js",
        "js/copy_url.js",
        "js/mascot.js",
        "js/extension_support.js",
        "js/main.js"
      ],
      "css": [
        "css/variables.css",
        "css/floating_menu.css",
        "css/search.css",
        "css/favorites.css",
        "css/authorization.css",
        "css/copy_url.css",
        "css/scroll_top.css",
        "css/mascot.css",
        "css/extension_support.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*/*docs*",
        "*://*/*swagger*",
        "*://*/*openapi*"
      ],
      "js": [
        "js/schema_navigation.js",
        "js/favorites_bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "css/*.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
